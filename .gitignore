# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local coworker correspondence and notes
coworkers/*

# LLM-direct SN transfer output (large, machine-generated)
output/

# Runtime config (user-specific, hot-reloaded)
llm_direct_sn_unv2notyet/.run_config.conf
llm_direct_sn_unv2notyet/.target_version
llm_direct_sn_unv2notyet/.window_budget.json
llm_direct_sn_unv2notyet/.codex_schema.json
llm_direct_sn_unv2notyet/.codex_last_message.txt

# Survey1 — large machine-generated results, temp files
llm_direct_sn_unv2notyet/survey1_prompt_evolving/round1_results/
llm_direct_sn_unv2notyet/survey1_prompt_evolving/round2_results/
llm_direct_sn_unv2notyet/survey1_prompt_evolving/round3_results/
llm_direct_sn_unv2notyet/survey1_prompt_evolving/gold_standard/
llm_direct_sn_unv2notyet/survey1_prompt_evolving/run_logs/
llm_direct_sn_unv2notyet/survey1_prompt_evolving/.codex_schema.json
llm_direct_sn_unv2notyet/survey1_prompt_evolving/.codex_last_message.txt

# Large binary database files
original_text_preparation/source_sqlite/*.db
original_text_preparation/source_sqlite/*.zip

# parsing/ response.history — retains raw names/details for local reference only
parsing/response.history
parsing/response.history.backups/
parsing/prompt.history.backups/
# Local names-retained companions (real names/handles — never commit)
parsing/*.local.md

# Showoff review system — credentials, sessions, user data
showoff_finished_4review/smtp_config.json
showoff_finished_4review/reviewers.json
showoff_finished_4review/reviews.json
showoff_finished_4review/sessions.json
showoff_finished_4review/otp_pending.json

# Adjudication of stuck gold verses
# stuck_index.json is derived (regenerate: python3 adjudication/build_stuck_index.py)
# and the gold corpus is live-growing, so it would churn on every run.
llm_direct_sn_unv2notyet/adjudication/stuck_index.json
# verdicts.jsonl carries reviewer emails — same policy as reviews.json
llm_direct_sn_unv2notyet/adjudication/verdicts.jsonl
